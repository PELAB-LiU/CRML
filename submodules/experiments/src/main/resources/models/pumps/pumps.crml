model PumpingSystem is FORM_L
	
	union {

		class Pump is {
			String ident;

			Boolean systemInOperation is external;
			Boolean isStarted is external;
			Real temperature is external;
			
			// R1: While the system is in operation, the pump must not be started more than twice.
			Boolean R1 is
				('during' systemInOperation) 'check count' (isStarted 'becomes true') '<=' 2;
			// R2: At least one hour must separate two consecutive pump startups.
			Boolean R2 is
				('after' (isStarted 'becomes true') 'for' 1) 'check count' (isStarted 'becomes true') '==' 0;
			// R3: While the pump is in operation (i.e. started), its temperature must always stay below 50°C.
			Boolean R3 is
				('during' isStarted) 'ensure' temperature < 50;
//			// R4: While the pump is in operation, after the pump temperature rises above 40 °C,
//			// the temperature must not stay above for a duration of more than 1 mn cumulated over the next 15 mn.
//			Boolean R4 is
//				('during' systemInOperation) 'ensure' (('after' (temperature > 40 'becomes true') 'for' 15)
//					('check duration' (temperature > 40) '<' 1)
//					);
		};
		
		Boolean inOperation is external;
		Pump pump1(systemInOperation=inOperation, ident = "PO1");
		Pump pump2(systemInOperation=inOperation, ident = "PO2");
		Pump pump3(systemInOperation=inOperation, ident = "PO3");		
};