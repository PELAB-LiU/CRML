// Temporal: each element once, of the right kind, directly in UseLifting's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected 2")
pattern count_CustomOperator_Temporal_referrers_TraceLink_is_2(n : java Integer) {
    n == count find count_CustomOperator_Temporal_referrers_TraceLink_is_2_matches(_);
    check(n != 2);
}

pattern count_CustomOperator_Temporal_referrers_TraceLink_is_2_matches(traceLink) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Temporal");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseLifting.trace");
    TraceLink.kind(traceLink, TraceLinkKind::OPERATOR_TO_BLOCK);
}

@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_Temporal_referrers_TraceLink_kind_is_OPERATOR_TO_BLOCK(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Temporal");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseLifting.trace");
    TraceLink.kind(traceLink, kind);
    kind != TraceLinkKind::OPERATOR_TO_BLOCK;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Temporal");
    neg find all_CustomOperator_Temporal_referrers_TraceLink_kind_is_OPERATOR_TO_BLOCK_path(customOperator, TraceLinkKind::OPERATOR_TO_BLOCK);
}

pattern all_CustomOperator_Temporal_referrers_TraceLink_kind_is_OPERATOR_TO_BLOCK_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseLifting.trace");
    TraceLink.kind(traceLink, v);
}

@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_Temporal_referrers_TraceLink_modelica_container_is_TraceLink(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Temporal");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseLifting.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(customOperator, traceLink2);
    find fileOf(traceLink2, "UseLifting.trace");
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Temporal");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseLifting.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_CustomOperator_Temporal_referrers_TraceLink_modelica_container_is_TraceLink_path(customOperator, modelica);
}

pattern all_CustomOperator_Temporal_referrers_TraceLink_modelica_container_is_TraceLink_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseLifting.trace");
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

// ---- Call sites and structure
// r instantiates the 'during all' block, which instantiates the 'during' block per period.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_UseLifting_r_definition_referrers_TraceLink_modelica_declaredType_targe(n : java Integer) {
    n == count find Variable_UseLifting_r_definition_referrers_TraceLink_modelica_declaredType_targe_matches(_);
    check(n != 1);
}

pattern Variable_UseLifting_r_definition_referrers_TraceLink_modelica_declaredType_targe_matches(r : Variable) {
    Variable(r);
    find containerOf(r, container);
    NamedEntity.name(container, "UseLifting");
    Variable.name(r, "r");
    CustomOperator(customOperator);
    find containerOf(customOperator, container2);
    Library.name(container2, "Temporal");
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'during all'");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseLifting.trace");
    TraceLink.modelica(traceLink, modelica);
    Variable.definition(r, definition);
    find traceLinkOf(definition, traceLink2);
    find fileOf(traceLink2, "UseLifting.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VALUE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    ComponentDeclaration.declaredType(modelica2, declaredType);
    Reference.target(declaredType, modelica);
    1 == count find Variable_UseLifting_r_definition_referrers_TraceLink_modelica_declaredType_targe_path(r, _);
}

pattern Variable_UseLifting_r_definition_referrers_TraceLink_modelica_declaredType_targe_path(o : Variable, v) {
    Variable.definition(o, definition);
    find traceLinkOf(definition, traceLink);
    find fileOf(traceLink, "UseLifting.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VALUE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    ComponentDeclaration.declaredType(modelica, declaredType);
    Reference.target(declaredType, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern CustomOperator_Temporal_during_all_referrers_TraceLink_modelica_components_decla(n : java Integer) {
    n == count find CustomOperator_Temporal_during_all_referrers_TraceLink_modelica_components_decla_matches(_);
    check(n != 1);
}

pattern CustomOperator_Temporal_during_all_referrers_TraceLink_modelica_components_decla_matches(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Temporal");
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'during all'");
    CustomOperator(customOperator2);
    find containerOf(customOperator2, container2);
    Library.name(container2, "Temporal");
    CustomOperator.header(customOperator2, header2);
    Keyword(header2);
    Keyword.keyword(header2, "'during'");
    find traceLinkOf(customOperator2, traceLink);
    find fileOf(traceLink, "UseLifting.trace");
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(customOperator, traceLink2);
    find fileOf(traceLink2, "UseLifting.trace");
    TraceLink.modelica(traceLink2, modelica2);
    ClassDefinition.components(modelica2, components);
    ComponentDeclaration.declaredType(components, declaredType);
    Reference.target(declaredType, target);
    find nameOf2(target, name);
    name != "";
    Reference.target(declaredType, modelica);
}

// Steps that features of several classes answer.

pattern traceLinkOf(o : EObject, value : EObject) {
    TraceLink.crml(value, o);
} or {
    TraceLink.modelica(value, o);
}

pattern nameOf(o : EObject, value) {
    NamedEntity.name(o, value);
} or {
    LibraryDependency.name(o, value);
} or {
    ClassDefinition.name(o, value);
} or {
    ComponentDeclaration.name(o, value);
} or {
    ModificationElement.name(o, value);
} or {
    ReferencePart.name(o, value);
}

pattern partialOf(o : EObject, value) {
    Domain.partial(o, value);
} or {
    ClassDefinition.partial(o, value);
}

pattern nameOf2(o : EObject, value) {
    ClassDefinition.name(o, value);
} or {
    ComponentDeclaration.name(o, value);
} or {
    ModificationElement.name(o, value);
} or {
    ReferencePart.name(o, value);
}
