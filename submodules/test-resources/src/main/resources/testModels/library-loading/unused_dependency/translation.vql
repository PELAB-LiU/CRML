pattern Variable_UseNothing_x_referrers_TraceLink_modelica_name_is_x_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    find nameOf(modelica, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_UseNothing_y_referrers_TraceLink_modelica_name_is_y(n : java Integer) {
    n == count find Variable_UseNothing_y_referrers_TraceLink_modelica_name_is_y_matches(_);
    check(n != 1);
