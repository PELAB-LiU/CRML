// Logic: each element once, of the right kind, directly in UseNothing's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_CustomOperator_Logic_referrers_TraceLink_is_1(n : java Integer) {
    n == count find count_CustomOperator_Logic_referrers_TraceLink_is_1_matches(_);
    check(n != 1);
}

pattern count_CustomOperator_Logic_referrers_TraceLink_is_1_matches(traceLink) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Logic");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.kind(traceLink, TraceLinkKind::OPERATOR_TO_FUNCTION);
}

@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_Logic_referrers_TraceLink_kind_is_OPERATOR_TO_FUNCTION(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Logic");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.kind(traceLink, kind);
    kind != TraceLinkKind::OPERATOR_TO_FUNCTION;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Logic");
    neg find all_CustomOperator_Logic_referrers_TraceLink_kind_is_OPERATOR_TO_FUNCTION_path(customOperator, TraceLinkKind::OPERATOR_TO_FUNCTION);
}

pattern all_CustomOperator_Logic_referrers_TraceLink_kind_is_OPERATOR_TO_FUNCTION_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.kind(traceLink, v);
}

@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_Logic_referrers_TraceLink_modelica_container_is_TraceLink_MOD(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Logic");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(customOperator, traceLink2);
    find fileOf(traceLink2, "UseNothing.trace");
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Logic");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_CustomOperator_Logic_referrers_TraceLink_modelica_container_is_TraceLink_MOD_path(customOperator, modelica);
}

pattern all_CustomOperator_Logic_referrers_TraceLink_modelica_container_is_TraceLink_MOD_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

// ---- Call sites and structure
// y is bound to x; Logic's 'or' is emitted but nothing calls it.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_UseNothing_y_referrers_TraceLink_modelica_binding_parts_name_is_x(n : java Integer) {
    n == count find Variable_UseNothing_y_referrers_TraceLink_modelica_binding_parts_name_is_x_matches(_);
    check(n != 1);
}

pattern Variable_UseNothing_y_referrers_TraceLink_modelica_binding_parts_name_is_x_matches(y : Variable) {
    Variable(y);
    find containerOf(y, container);
    NamedEntity.name(container, "UseNothing");
    Variable.name(y, "y");
    find traceLinkOf(y, traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    ComponentDeclaration.binding(modelica, binding);
    ComponentReference.parts(binding, parts);
    ReferencePart.name(parts, "x");
    1 == count find Variable_UseNothing_y_referrers_TraceLink_modelica_binding_parts_name_is_x_path(y, _);
}

pattern Variable_UseNothing_y_referrers_TraceLink_modelica_binding_parts_name_is_x_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    ComponentDeclaration.binding(modelica, binding);
    ComponentReference.parts(binding, parts);
    ReferencePart.name(parts, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern CustomOperator_Logic_or_referrers_TraceLink_modelica_referrers_Reference_empty(n : java Integer) {
    n == count find CustomOperator_Logic_or_referrers_TraceLink_modelica_referrers_Reference_empty_matches(_);
    check(n != 1);
}

pattern CustomOperator_Logic_or_referrers_TraceLink_modelica_referrers_Reference_empty_matches(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Logic");
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'or'");
    neg find CustomOperator_Logic_or_referrers_TraceLink_modelica_referrers_Reference_empty_path(customOperator, _);
}

pattern CustomOperator_Logic_or_referrers_TraceLink_modelica_referrers_Reference_empty_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseNothing.trace");
    TraceLink.modelica(traceLink, modelica);
    Reference.target(v, modelica);
}

// Steps that features of several classes answer.

pattern traceLinkOf(o : EObject, value : EObject) {
    TraceLink.crml(value, o);
} or {
    TraceLink.modelica(value, o);
}

pattern nameOf(o : EObject, value) {
    NamedEntity.name(o, value);
} or {
    LibraryDependency.name(o, value);
} or {
    ClassDefinition.name(o, value);
} or {
    ComponentDeclaration.name(o, value);
} or {
    ModificationElement.name(o, value);
} or {
    ReferencePart.name(o, value);
}

pattern partialOf(o : EObject, value) {
    Domain.partial(o, value);
} or {
    ClassDefinition.partial(o, value);
}
