}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_UseOperator_not_x_referrers_TraceLink_modelica_name_is_not_x(n : java Integer) {
    n == count find Variable_UseOperator_not_x_referrers_TraceLink_modelica_name_is_not_x_matches(_);
