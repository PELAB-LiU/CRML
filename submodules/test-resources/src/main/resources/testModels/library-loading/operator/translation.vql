// Negation: each element once, of the right kind, directly in UseOperator's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_CustomOperator_Negation_referrers_TraceLink_is_1(n : java Integer) {
    n == count find count_CustomOperator_Negation_referrers_TraceLink_is_1_matches(_);
    check(n != 1);
}

pattern count_CustomOperator_Negation_referrers_TraceLink_is_1_matches(traceLink) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Negation");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::OPERATOR_TO_FUNCTION);
}

@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_Negation_referrers_TraceLink_kind_is_OPERATOR_TO_FUNCTION(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Negation");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, kind);
    kind != TraceLinkKind::OPERATOR_TO_FUNCTION;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Negation");
    neg find all_CustomOperator_Negation_referrers_TraceLink_kind_is_OPERATOR_TO_FUNCTION_path(customOperator, TraceLinkKind::OPERATOR_TO_FUNCTION);
}

pattern all_CustomOperator_Negation_referrers_TraceLink_kind_is_OPERATOR_TO_FUNCTION_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, v);
}

@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_Negation_referrers_TraceLink_modelica_container_is_TraceLink(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Negation");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(customOperator, traceLink2);
    find fileOf(traceLink2, "UseOperator.trace");
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Negation");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_CustomOperator_Negation_referrers_TraceLink_modelica_container_is_TraceLink_path(customOperator, modelica);
}

pattern all_CustomOperator_Negation_referrers_TraceLink_modelica_container_is_TraceLink_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

// ---- Call sites and structure
// not_x calls Negation's function.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_UseOperator_not_x_referrers_TraceLink_modelica_binding_function_target(n : java Integer) {
    n == count find Variable_UseOperator_not_x_referrers_TraceLink_modelica_binding_function_target_matches(_);
    check(n != 1);
}

pattern Variable_UseOperator_not_x_referrers_TraceLink_modelica_binding_function_target_matches(not_x : Variable) {
    Variable(not_x);
    find containerOf(not_x, container);
    NamedEntity.name(container, "UseOperator");
    Variable.name(not_x, "not_x");
    CustomOperator(customOperator);
    find containerOf(customOperator, container2);
    Library.name(container2, "Negation");
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'negation of'");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(not_x, traceLink2);
    find fileOf(traceLink2, "UseOperator.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    ComponentDeclaration.binding(modelica2, binding);
    FunctionCall.function(binding, function);
    Reference.target(function, modelica);
    1 == count find Variable_UseOperator_not_x_referrers_TraceLink_modelica_binding_function_target_path(not_x, _);
}

pattern Variable_UseOperator_not_x_referrers_TraceLink_modelica_binding_function_target_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    ComponentDeclaration.binding(modelica, binding);
    FunctionCall.function(binding, function);
    Reference.target(function, v);
}

// Steps that features of several classes answer.

pattern traceLinkOf(o : EObject, value : EObject) {
    TraceLink.crml(value, o);
} or {
    TraceLink.modelica(value, o);
}

pattern nameOf(o : EObject, value) {
    NamedEntity.name(o, value);
} or {
    LibraryDependency.name(o, value);
} or {
    ClassDefinition.name(o, value);
} or {
    ComponentDeclaration.name(o, value);
} or {
    ModificationElement.name(o, value);
} or {
    ReferencePart.name(o, value);
}

pattern partialOf(o : EObject, value) {
    Domain.partial(o, value);
} or {
    ClassDefinition.partial(o, value);
}
