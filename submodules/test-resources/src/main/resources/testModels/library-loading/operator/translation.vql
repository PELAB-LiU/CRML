    1 == count find Variable_UseOperator_not_x_referrers_TraceLink_modelica_name_is_not_x_path(not_x, _);
}

pattern Variable_UseOperator_not_x_referrers_TraceLink_modelica_name_is_not_x_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
