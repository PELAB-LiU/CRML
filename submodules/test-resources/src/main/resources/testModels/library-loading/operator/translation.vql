}

pattern Variable_UseOperator_not_x_referrers_TraceLink_modelica_name_is_not_x_matches(not_x : Variable) {
    Variable(not_x);
    find containerOf(not_x, container);
    NamedEntity.name(container, "UseOperator");
    Variable.name(not_x, "not_x");
    find traceLinkOf(not_x, traceLink);
