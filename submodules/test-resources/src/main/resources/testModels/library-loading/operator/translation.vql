package expectations;

import "http://www.eclipse.org/emf/2002/Ecore";
import "org.openmodelica.crml.model.metamodel" as model;
import "org.openmodelica.crml.modelica.metamodel" as modelica;
import "org.openmodelica.crml.modelica.trace.metamodel" as trace;

// A keyword operator from a library.
// <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
// (see LibraryLoading in :compiler and "Checking a translation" in
// EXPECTATIONS.md). Every expected value follows from the CRML sources.

// What is quantified over, so that no 'all' below passes vacuously.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected 2")
pattern count_Variable_UseOperator_is_2(n : java Integer) {
    n == count find count_Variable_UseOperator_is_2_matches(_);
    check(n != 2);
}

pattern count_Variable_UseOperator_is_2_matches(variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseOperator");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_CustomOperator_Negation_is_1(n : java Integer) {
    n == count find count_CustomOperator_Negation_is_1_matches(_);
    check(n != 1);
}

pattern count_CustomOperator_Negation_is_1_matches(customOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Negation");
}

// ---- UseOperator

// Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Model_UseOperator_referrers_TraceLink_modelica_file_is_UseOperator_mo(n : java Integer) {
    n == count find Model_UseOperator_referrers_TraceLink_modelica_file_is_UseOperator_mo_matches(_);
    check(n != 1);
}

pattern Model_UseOperator_referrers_TraceLink_modelica_file_is_UseOperator_mo_matches(useOperator : Model) {
    Model.name(useOperator, "UseOperator");
    find traceLinkOf(useOperator, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, "UseOperator.mo");
    1 == count find Model_UseOperator_referrers_TraceLink_modelica_file_is_UseOperator_mo_path(useOperator, _);
}

pattern Model_UseOperator_referrers_TraceLink_modelica_file_is_UseOperator_mo_path(o : Model, v) {
    find traceLinkOf(o, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_UseOperator(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_name_is_UseOperator_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_UseOperator_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find nameOf(modelica, "UseOperator");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_true(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_partial_is_true_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_true_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find partialOf(modelica, true);
}

// Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
@Constraint(key = {traceLink}, severity = "error", message = "must not exist")
pattern count_TraceLink_UNSUPPORTED_is_0(traceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
}

@Constraint(key = {placeholder}, severity = "error", message = "must not exist")
pattern count_Placeholder_is_0(placeholder) {
    Placeholder(placeholder);
    find fileOf(placeholder, "UseOperator.mo");
}

@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_UNRESOLVED_not_empty_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "UseOperator.mo");
    Reference.reason(reference, RawReason::UNRESOLVED);
    Reference.rawText(reference, rawText);
    rawText != "";
}

@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_not_UseOperator_mo_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "UseOperator.mo");
    Reference.target(reference, target);
    find fileOf(target, file);
    file != "UseOperator.mo";
}

// Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected 2")
pattern count_ClassDefinition_is_2(n : java Integer) {
    n == count find count_ClassDefinition_is_2_matches(_);
    check(n != 2);
}

pattern count_ClassDefinition_is_2_matches(classDefinition) {
    ClassDefinition(classDefinition);
    find fileOf(classDefinition, "UseOperator.mo");
}

// UseOperator (own): each element once, of the right kind, directly in UseOperator's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected 2")
pattern count_Variable_UseOperator_referrers_TraceLink_is_2(n : java Integer) {
    n == count find count_Variable_UseOperator_referrers_TraceLink_is_2_matches(_);
    check(n != 2);
}

pattern count_Variable_UseOperator_referrers_TraceLink_is_2_matches(traceLink) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseOperator");
    find traceLinkOf(variable, traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
}

@Constraint(key = {variable}, severity = "error", message = "counterexample")
pattern all_Variable_UseOperator_referrers_TraceLink_modelica_container_is_TraceLink_MOD(variable : Variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseOperator");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(variable, traceLink2);
    find fileOf(traceLink2, "UseOperator.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseOperator");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_Variable_UseOperator_referrers_TraceLink_modelica_container_is_TraceLink_MOD_path(variable, modelica);
}

pattern all_Variable_UseOperator_referrers_TraceLink_modelica_container_is_TraceLink_MOD_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseOperator.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

