package expectations;

import "http://www.eclipse.org/emf/2002/Ecore";
import "org.openmodelica.crml.model.metamodel" as metamodel;

// 'implies' is the model's own; the 'or' inside it is Logic's.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_x_implies_y_definition_operator_root_name_is_MixLocal(n : java Integer) {
    n == count find Variable_x_implies_y_definition_operator_root_name_is_MixLocal_matches(_);
    check(n != 1);
}

pattern Variable_x_implies_y_definition_operator_root_name_is_MixLocal_matches(x_implies_y : Variable) {
    Variable.name(x_implies_y, "x_implies_y");
    Variable.definition(x_implies_y, definition);
    ComputedValue.operator(definition, operator);
    find rootOf(operator, root);
    find nameOf(root, "MixLocal");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Template_implies_definition_operator_root_name_is_Logic(n : java Integer) {
    n == count find Template_implies_definition_operator_root_name_is_Logic_matches(_);
    check(n != 1);
}

pattern Template_implies_definition_operator_root_name_is_Logic_matches(template : Template) {
    Template.header(template, header);
    Keyword(header);
    Keyword.keyword(header, "'implies'");
    Template.definition(template, definition);
    ComputedValue.operator(definition, operator);
    find rootOf(operator, root);
    find nameOf(root, "Logic");
}

// Some operator declared in MixLocal calls into Logic.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected at least 1")
pattern some_MixLocal_CustomOperator_definition_operator_root_name_is_Logic(n : java Integer) {
    n == count find some_MixLocal_CustomOperator_definition_operator_root_name_is_Logic_matches(_);
    check(n < 1);
}

pattern some_MixLocal_CustomOperator_definition_operator_root_name_is_Logic_matches(customOperator : CustomOperator) {
    Model.name(mixLocal, "MixLocal");
    CustomOperator(customOperator);
    find containerOf+(customOperator, mixLocal);
    CustomOperator.definition(customOperator, definition);
    ComputedValue.operator(definition, operator);
    find rootOf(operator, root);
    find nameOf(root, "Logic");
}

// Steps that features of several classes answer.

pattern nameOf(o : EObject, value) {
    NamedEntity.name(o, value);
} or {
    LibraryDependency.name(o, value);
}
