package expectations;

import "http://www.eclipse.org/emf/2002/Ecore";
import "org.openmodelica.crml.model.metamodel" as model;
import "org.openmodelica.crml.modelica.metamodel" as modelica;
import "org.openmodelica.crml.modelica.trace.metamodel" as trace;

// A model on a faulty library: Lib's operator refers to an unknown name.
// UseLib's own elements reach the generated Modelica. Lib's operator does not:
// translating it fails at the unresolved reference, which becomes the one
// placeholder of UseLib.mo. <Model>.mo is the Modelica class generated for a
// model, <Model>.trace its trace (see LibraryLoading in :compiler and
// "Checking a translation" in EXPECTATIONS.md).

// What is quantified over, so that no 'all' below passes vacuously.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Variable_UseLib_is_1(n : java Integer) {
    n == count find count_Variable_UseLib_is_1_matches(_);
    check(n != 1);
}

pattern count_Variable_UseLib_is_1_matches(variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseLib");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_CustomOperator_Lib_is_1(n : java Integer) {
    n == count find count_CustomOperator_Lib_is_1_matches(_);
    check(n != 1);
}

pattern count_CustomOperator_Lib_is_1_matches(customOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Lib");
}

// ---- UseLib

// Its class, partial: x is external.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Model_UseLib_referrers_TraceLink_modelica_file_is_UseLib_mo(n : java Integer) {
    n == count find Model_UseLib_referrers_TraceLink_modelica_file_is_UseLib_mo_matches(_);
    check(n != 1);
}

pattern Model_UseLib_referrers_TraceLink_modelica_file_is_UseLib_mo_matches(useLib : Model) {
    Model.name(useLib, "UseLib");
    find traceLinkOf(useLib, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, "UseLib.mo");
    1 == count find Model_UseLib_referrers_TraceLink_modelica_file_is_UseLib_mo_path(useLib, _);
}

pattern Model_UseLib_referrers_TraceLink_modelica_file_is_UseLib_mo_path(o : Model, v) {
    find traceLinkOf(o, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_UseLib(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_name_is_UseLib_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_UseLib_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "UseLib.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find nameOf(modelica, "UseLib");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_true(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_partial_is_true_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_true_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "UseLib.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find partialOf(modelica, true);
}

// No unresolved name in the Modelica, no reference into another model's class.
@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_UNRESOLVED_not_empty_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "UseLib.mo");
    Reference.reason(reference, RawReason::UNRESOLVED);
    Reference.rawText(reference, rawText);
    rawText != "";
}

@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_not_UseLib_mo_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "UseLib.mo");
    Reference.target(reference, target);
    find fileOf(target, file);
    file != "UseLib.mo";
}

// One generated class: Lib's operator is not emitted.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_ClassDefinition_is_1(n : java Integer) {
    n == count find count_ClassDefinition_is_1_matches(_);
    check(n != 1);
}

pattern count_ClassDefinition_is_1_matches(classDefinition) {
    ClassDefinition(classDefinition);
    find fileOf(classDefinition, "UseLib.mo");
}

// UseLib (own): each variable once, directly in UseLib's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Variable_UseLib_referrers_TraceLink_is_1(n : java Integer) {
    n == count find count_Variable_UseLib_referrers_TraceLink_is_1_matches(_);
    check(n != 1);
}

pattern count_Variable_UseLib_referrers_TraceLink_is_1_matches(traceLink) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseLib");
    find traceLinkOf(variable, traceLink);
    find fileOf(traceLink, "UseLib.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
}

@Constraint(key = {variable}, severity = "error", message = "counterexample")
pattern all_Variable_UseLib_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_TO(variable : Variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseLib");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseLib.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(variable, traceLink2);
    find fileOf(traceLink2, "UseLib.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseLib");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseLib.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_Variable_UseLib_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_TO_path(variable, modelica);
}

pattern all_Variable_UseLib_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_TO_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseLib.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_UseLib_x_referrers_TraceLink_modelica_name_is_x(n : java Integer) {
    n == count find Variable_UseLib_x_referrers_TraceLink_modelica_name_is_x_matches(_);
    check(n != 1);
}

pattern Variable_UseLib_x_referrers_TraceLink_modelica_name_is_x_matches(x : Variable) {
    Variable(x);
    find containerOf(x, container);
    NamedEntity.name(container, "UseLib");
    Variable.name(x, "x");
    find traceLinkOf(x, traceLink);
    find fileOf(traceLink, "UseLib.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    find nameOf(modelica, "x");
    1 == count find Variable_UseLib_x_referrers_TraceLink_modelica_name_is_x_path(x, _);
}

pattern Variable_UseLib_x_referrers_TraceLink_modelica_name_is_x_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseLib.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    find nameOf(modelica, v);
}

@Constraint(key = {variable}, severity = "error", message = "counterexample")
pattern all_Variable_UseLib_referrers_TraceLink_empty(variable : Variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseLib");
    find traceLinkOf(variable, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
    traceLink == _;
}

// Lib's operator is not emitted ...
@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_Lib_referrers_TraceLink_empty(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Lib");
    find traceLinkOf(customOperator, _);
}

// ... and the unresolved reference in it is the one placeholder, directly in UseLib's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_TraceLink_UNSUPPORTED_is_1(n : java Integer) {
    n == count find count_TraceLink_UNSUPPORTED_is_1_matches(_);
    check(n != 1);
}

pattern count_TraceLink_UNSUPPORTED_is_1_matches(traceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "UseLib.trace");
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_UNSUPPORTED_crml_root_name_is_Lib(n : java Integer) {
    n == count find TraceLink_UNSUPPORTED_crml_root_name_is_Lib_matches(_);
    check(n != 1);
}

pattern TraceLink_UNSUPPORTED_crml_root_name_is_Lib_matches(traceLink : TraceLink) {
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
    TraceLink.crml(traceLink, crml);
    find rootOf(crml, root);
    find nameOf(root, "Lib");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_UNSUPPORTED_crml_isA_VariableReference(n : java Integer) {
    n == count find TraceLink_UNSUPPORTED_crml_isA_VariableReference_matches(_);
    check(n != 1);
}

pattern TraceLink_UNSUPPORTED_crml_isA_VariableReference_matches(traceLink : TraceLink) {
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
    TraceLink.crml(traceLink, crml);
    VariableReference(crml);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_UNSUPPORTED_modelica_isA_Placeholder(n : java Integer) {
    n == count find TraceLink_UNSUPPORTED_modelica_isA_Placeholder_matches(_);
    check(n != 1);
}

pattern TraceLink_UNSUPPORTED_modelica_isA_Placeholder_matches(traceLink : TraceLink) {
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
    TraceLink.modelica(traceLink, modelica);
    Placeholder(modelica);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_UNSUPPORTED_modelica_container_is_TraceLink_MODEL_TO_CLASS(n : java Integer) {
    n == count find TraceLink_UNSUPPORTED_modelica_container_is_TraceLink_MODEL_TO_CLASS_matches(_);
    check(n != 1);
}

pattern TraceLink_UNSUPPORTED_modelica_container_is_TraceLink_MODEL_TO_CLASS_matches(traceLink : TraceLink) {
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
    TraceLink(traceLink2);
    find fileOf(traceLink2, "UseLib.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink2, modelica);
    TraceLink.modelica(traceLink, modelica2);
    find containerOf(modelica2, modelica);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Placeholder_is_1(n : java Integer) {
    n == count find count_Placeholder_is_1_matches(_);
    check(n != 1);
}

pattern count_Placeholder_is_1_matches(placeholder) {
    Placeholder(placeholder);
    find fileOf(placeholder, "UseLib.mo");
}

// Steps that features of several classes answer.

pattern traceLinkOf(o : EObject, value : EObject) {
    TraceLink.crml(value, o);
} or {
    TraceLink.modelica(value, o);
}

pattern nameOf(o : EObject, value) {
    NamedEntity.name(o, value);
} or {
    LibraryDependency.name(o, value);
} or {
    ClassDefinition.name(o, value);
} or {
    ComponentDeclaration.name(o, value);
} or {
    ModificationElement.name(o, value);
} or {
    ReferencePart.name(o, value);
}

pattern partialOf(o : EObject, value) {
    Domain.partial(o, value);
} or {
    ClassDefinition.partial(o, value);
}
