    find containerOf(customOperator, container);
    Library.name(container, "Base");
    TraceLink(traceLink);
    find fileOf(traceLink, "Derived.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_CustomOperator_Base_referrers_TraceLink_modelica_container_is_TraceLink_MODE_2_path(customOperator, modelica);
}

pattern all_CustomOperator_Base_referrers_TraceLink_modelica_container_is_TraceLink_MODE_2_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "Derived.trace");
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected 2")
pattern count_Variable_Base_referrers_TraceLink_is_2_2(n : java Integer) {
    n == count find count_Variable_Base_referrers_TraceLink_is_2_2_matches(_);
    check(n != 2);
}

pattern count_Variable_Base_referrers_TraceLink_is_2_2_matches(traceLink) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "Base");
    find traceLinkOf(variable, traceLink);
    find fileOf(traceLink, "Derived.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
}

@Constraint(key = {variable}, severity = "error", message = "counterexample")
pattern all_Variable_Base_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_TO_C_2(variable : Variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "Base");
    TraceLink(traceLink);
    find fileOf(traceLink, "Derived.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(variable, traceLink2);
    find fileOf(traceLink2, "Derived.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "Base");
    TraceLink(traceLink);
    find fileOf(traceLink, "Derived.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_Variable_Base_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_TO_C_2_path(variable, modelica);
}

pattern all_Variable_Base_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_TO_C_2_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "Derived.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

