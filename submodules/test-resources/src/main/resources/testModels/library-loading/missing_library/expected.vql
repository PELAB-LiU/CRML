package expectations;

import "http://www.eclipse.org/emf/2002/Ecore";
import "org.openmodelica.crml.model.metamodel" as metamodel;

// Nothing called Missing is loaded; the model itself is still built and linked.
@Constraint(key = {missing}, severity = "error", message = "must not exist")
pattern count_Library_Missing_is_0(missing) {
    Library.name(missing, "Missing");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_x_domain_notEmpty(n : java Integer) {
    n == count find Variable_x_domain_notEmpty_matches(_);
    check(n != 1);
}

pattern Variable_x_domain_notEmpty_matches(x : Variable) {
    Variable.name(x, "x");
    Variable.domain(x, _);
}
