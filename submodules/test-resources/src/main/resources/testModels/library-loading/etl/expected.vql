package expectations;

import "http://www.eclipse.org/emf/2002/Ecore";
import "org.openmodelica.crml.model.metamodel" as metamodel;

// ETL is loaded once for the four models.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Library_ETL_is_1(n : java Integer) {
    n == count find count_Library_ETL_is_1_matches(_);
    check(n != 1);
}

pattern count_Library_ETL_is_1_matches(eTL) {
    Library.name(eTL, "ETL");
}

// Each model's call resolves to the ETL operator, and no call is left unresolved.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_b1_implies_b2_definition_operator_root_name_is_ETL(n : java Integer) {
    n == count find Variable_b1_implies_b2_definition_operator_root_name_is_ETL_matches(_);
    check(n != 1);
}

pattern Variable_b1_implies_b2_definition_operator_root_name_is_ETL_matches(b1_implies_b2 : Variable) {
    Variable.name(b1_implies_b2, "b1_implies_b2");
    Variable.definition(b1_implies_b2, definition);
    ComputedValue.operator(definition, operator);
    find rootOf(operator, root);
    find nameOf(root, "ETL");
}

