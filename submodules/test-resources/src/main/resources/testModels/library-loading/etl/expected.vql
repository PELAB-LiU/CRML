@Constraint(key = {sequence}, severity = "error", message = "must not exist")
pattern count_Implies_Sequence_is_0(sequence) {
    Model.name(implies, "Implies");
    Sequence(sequence);
    find containerOf+(sequence, implies);
}

@Constraint(key = {sequence}, severity = "error", message = "must not exist")
pattern count_BecomesTrueInside_Sequence_is_0(sequence) {
    Model.name(becomesTrueInside, "BecomesTrueInside");
    Sequence(sequence);
    find containerOf+(sequence, becomesTrueInside);
}

