@Constraint(key = {sequence}, severity = "error", message = "must not exist")
pattern count_CheckOver_Sequence_is_0(sequence) {
    Model.name(checkOver, "CheckOver");
    Sequence(sequence);
    find containerOf+(sequence, checkOver);
}

// ETL resolves its own calls: 'check' aggregates ("and" over a set, a BinaryOperator with
// only a right operand) calls to 'evaluate' (in parentheses: a SUBEXPRESSION
// UnaryOperator around the call), lifted over P.element.
@Constraint(key = {sequence}, severity = "error", message = "must not exist")
pattern count_ETL_Sequence_is_0(sequence) {
    Library.name(eTL, "ETL");
    Sequence(sequence);
    find containerOf+(sequence, eTL);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern CustomOperator_check_definition_rhs_value_operator_keywords_keyword_has_evaluate(n : java Integer) {
    n == count find CustomOperator_check_definition_rhs_value_operator_keywords_keyword_has_evaluate_matches(_);
    check(n != 1);
}

pattern CustomOperator_check_definition_rhs_value_operator_keywords_keyword_has_evaluate_matches(customOperator : CustomOperator) {
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'check'");
    CustomOperator.definition(customOperator, definition);
    BinaryOperator.rhs(definition, rhs);
    find valueOf(rhs, value);
    ComputedValue.operator(value, operator);
    CustomOperator.header(operator, header2);
    Keyword(header2);
    Keyword.keyword(header2, "'evaluate'");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern CustomOperator_check_definition_rhs_value_lifts_data_variable_name_is_P(n : java Integer) {
    n == count find CustomOperator_check_definition_rhs_value_lifts_data_variable_name_is_P_matches(_);
    check(n != 1);
}

pattern CustomOperator_check_definition_rhs_value_lifts_data_variable_name_is_P_matches(customOperator : CustomOperator) {
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'check'");
    CustomOperator.definition(customOperator, definition);
    BinaryOperator.rhs(definition, rhs);
    find valueOf(rhs, value);
    Liftable.lifts(value, lifts);
    ScatteredValue.data(lifts, data);
    VariableReference.variable(data, variable);
    Variable.name(variable, "P");
    1 == count find CustomOperator_check_definition_rhs_value_lifts_data_variable_name_is_P_path(customOperator, _);
}

pattern CustomOperator_check_definition_rhs_value_lifts_data_variable_name_is_P_path(o : CustomOperator, v) {
    CustomOperator.definition(o, definition);
    BinaryOperator.rhs(definition, rhs);
    find valueOf(rhs, value);
    Liftable.lifts(value, lifts);
    ScatteredValue.data(lifts, data);
    VariableReference.variable(data, variable);
    Variable.name(variable, v);
}

// Steps that features of several classes answer.

pattern nameOf(o : EObject, value) {
    NamedEntity.name(o, value);
} or {
    LibraryDependency.name(o, value);
}

pattern valueOf(o : EObject, value : EObject) {
    UnaryOperator.value(o, value);
} or {
    ConstructorValue.value(o, value);
} or {
    SequenceValue.value(o, value);
}
