// Operators calling operators of the same library.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern CustomOperator_ETL_becomes_true_inside_referrers_TraceLink_modelica_components_d(n : java Integer) {
    n == count find CustomOperator_ETL_becomes_true_inside_referrers_TraceLink_modelica_components_d_matches(_);
    check(n != 1);
}

pattern CustomOperator_ETL_becomes_true_inside_referrers_TraceLink_modelica_components_d_matches(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "ETL");
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'becomes true inside'");
    CustomOperator(customOperator2);
    find containerOf(customOperator2, container2);
    Library.name(container2, "ETL");
    CustomOperator.header(customOperator2, header2);
    Keyword(header2);
    Keyword.keyword(header2, "'inside'");
    1 == count find CustomOperator_ETL_becomes_true_inside_referrers_TraceLink_modelica_components_d_path(customOperator2, _);
    find traceLinkOf(customOperator2, traceLink);
    find fileOf(traceLink, "BecomesTrueInside.trace");
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(customOperator, traceLink2);
    find fileOf(traceLink2, "BecomesTrueInside.trace");
    TraceLink.modelica(traceLink2, modelica2);
    ClassDefinition.components(modelica2, components);
    ComponentDeclaration.declaredType(components, declaredType);
    Reference.target(declaredType, target);
    find nameOf2(target, name);
    name != "";
    Reference.target(declaredType, modelica);
}

pattern CustomOperator_ETL_becomes_true_inside_referrers_TraceLink_modelica_components_d_path(o : CustomOperator, v) {
    CustomOperator.header(o, header);
    Keyword(header);
    Keyword.keyword(header, v);
}

