// ---- Call sites and structure
// Each model's variable calls ETL's function, or instantiates ETL's block.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_Implies_b1_implies_b2_referrers_TraceLink_modelica_binding_function_tar(n : java Integer) {
    n == count find Variable_Implies_b1_implies_b2_referrers_TraceLink_modelica_binding_function_tar_matches(_);
    check(n != 1);
}

pattern Variable_Implies_b1_implies_b2_referrers_TraceLink_modelica_binding_function_tar_matches(b1_implies_b2 : Variable) {
    Variable(b1_implies_b2);
    find containerOf(b1_implies_b2, container);
    NamedEntity.name(container, "Implies");
    Variable.name(b1_implies_b2, "b1_implies_b2");
    CustomOperator(customOperator);
    find containerOf(customOperator, container2);
    Library.name(container2, "ETL");
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'implies'");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "Implies.trace");
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(b1_implies_b2, traceLink2);
    find fileOf(traceLink2, "Implies.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    ComponentDeclaration.binding(modelica2, binding);
    FunctionCall.function(binding, function);
    Reference.target(function, modelica);
    1 == count find Variable_Implies_b1_implies_b2_referrers_TraceLink_modelica_binding_function_tar_path(b1_implies_b2, _);
}

pattern Variable_Implies_b1_implies_b2_referrers_TraceLink_modelica_binding_function_tar_path(o : Variable, v) {
