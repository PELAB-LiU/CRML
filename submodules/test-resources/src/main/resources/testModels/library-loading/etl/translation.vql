@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_ETL_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_2(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "ETL");
    TraceLink(traceLink);
    find fileOf(traceLink, "CheckOver.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(customOperator, traceLink2);
    find fileOf(traceLink2, "CheckOver.trace");
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "ETL");
    TraceLink(traceLink);
    find fileOf(traceLink, "CheckOver.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_CustomOperator_ETL_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_2_path(customOperator, modelica);
}

pattern all_CustomOperator_ETL_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_2_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "CheckOver.trace");
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

// What CheckOver does not reach is not in it: scope flows one way only.
@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_BecomesTrueInside_referrers_file_lacks_CheckOver_trace(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "BecomesTrueInside");
    find referrerOf(customOperator, referrer);
    find fileOf(referrer, "CheckOver.trace");
}

