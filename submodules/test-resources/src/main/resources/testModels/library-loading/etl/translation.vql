pattern count_CustomOperator_ETL_referrers_TraceLink_is_7_2(n : java Integer) {
    n == count find count_CustomOperator_ETL_referrers_TraceLink_is_7_2_matches(_);
    check(n != 7);
}

pattern count_CustomOperator_ETL_referrers_TraceLink_is_7_2_matches(traceLink) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "ETL");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "CheckOver.trace");
    TraceLink.kind(traceLink, TraceLinkKind::OPERATOR_TO_FUNCTION);
}

