package expectations;

import "http://www.eclipse.org/emf/2002/Ecore";
import "org.openmodelica.crml.model.metamodel" as model;
import "org.openmodelica.crml.modelica.metamodel" as modelica;
import "org.openmodelica.crml.modelica.trace.metamodel" as trace;

// Every operator and template of ETL is emitted into each of the four models.
// <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
// (see LibraryLoading in :compiler and "Checking a translation" in
// EXPECTATIONS.md). Every expected value follows from the CRML sources.

// What is quantified over, so that no 'all' below passes vacuously.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected 3")
pattern count_Variable_BecomesTrueInside_is_3(n : java Integer) {
    n == count find count_Variable_BecomesTrueInside_is_3_matches(_);
    check(n != 3);
}

pattern count_Variable_BecomesTrueInside_is_3_matches(variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "BecomesTrueInside");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected 3")
pattern count_Variable_CheckOver_is_3(n : java Integer) {
    n == count find count_Variable_CheckOver_is_3_matches(_);
    check(n != 3);
}

pattern count_Variable_CheckOver_is_3_matches(variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "CheckOver");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected 5")
pattern count_Variable_CountInside_is_5(n : java Integer) {
    n == count find count_Variable_CountInside_is_5_matches(_);
    check(n != 5);
}

pattern count_Variable_CountInside_is_5_matches(variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "CountInside");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected 3")
pattern count_Variable_Implies_is_3(n : java Integer) {
    n == count find count_Variable_Implies_is_3_matches(_);
    check(n != 3);
}

pattern count_Variable_Implies_is_3_matches(variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "Implies");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected 15")
pattern count_CustomOperator_ETL_is_15(n : java Integer) {
    n == count find count_CustomOperator_ETL_is_15_matches(_);
    check(n != 15);
}

pattern count_CustomOperator_ETL_is_15_matches(customOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "ETL");
}

// ---- BecomesTrueInside

// Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Model_BecomesTrueInside_referrers_TraceLink_modelica_file_is_BecomesTrueInside_m(n : java Integer) {
    n == count find Model_BecomesTrueInside_referrers_TraceLink_modelica_file_is_BecomesTrueInside_m_matches(_);
    check(n != 1);
}

pattern Model_BecomesTrueInside_referrers_TraceLink_modelica_file_is_BecomesTrueInside_m_matches(becomesTrueInside : Model) {
    Model.name(becomesTrueInside, "BecomesTrueInside");
    find traceLinkOf(becomesTrueInside, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, "BecomesTrueInside.mo");
    1 == count find Model_BecomesTrueInside_referrers_TraceLink_modelica_file_is_BecomesTrueInside_m_path(becomesTrueInside, _);
}

pattern Model_BecomesTrueInside_referrers_TraceLink_modelica_file_is_BecomesTrueInside_m_path(o : Model, v) {
    find traceLinkOf(o, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_BecomesTrueInside(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_name_is_BecomesTrueInside_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_BecomesTrueInside_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "BecomesTrueInside.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find nameOf(modelica, "BecomesTrueInside");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_true(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_partial_is_true_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_true_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "BecomesTrueInside.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find partialOf(modelica, true);
}

// Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
@Constraint(key = {traceLink}, severity = "error", message = "must not exist")
pattern count_TraceLink_UNSUPPORTED_is_0(traceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "BecomesTrueInside.trace");
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
}

@Constraint(key = {placeholder}, severity = "error", message = "must not exist")
pattern count_Placeholder_is_0(placeholder) {
    Placeholder(placeholder);
    find fileOf(placeholder, "BecomesTrueInside.mo");
}

@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_UNRESOLVED_not_empty_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "BecomesTrueInside.mo");
    Reference.reason(reference, RawReason::UNRESOLVED);
    Reference.rawText(reference, rawText);
    rawText != "";
}

@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_not_BecomesTrueInside_mo_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "BecomesTrueInside.mo");
    Reference.target(reference, target);
    find fileOf(target, file);
    file != "BecomesTrueInside.mo";
}

// Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected 16")
pattern count_ClassDefinition_is_16(n : java Integer) {
    n == count find count_ClassDefinition_is_16_matches(_);
    check(n != 16);
}

pattern count_ClassDefinition_is_16_matches(classDefinition) {
    ClassDefinition(classDefinition);
    find fileOf(classDefinition, "BecomesTrueInside.mo");
}

// BecomesTrueInside (own): each element once, of the right kind, directly in BecomesTrueInside's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected 3")
pattern count_Variable_BecomesTrueInside_referrers_TraceLink_is_3(n : java Integer) {
    n == count find count_Variable_BecomesTrueInside_referrers_TraceLink_is_3_matches(_);
    check(n != 3);
}

pattern count_Variable_BecomesTrueInside_referrers_TraceLink_is_3_matches(traceLink) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "BecomesTrueInside");
    find traceLinkOf(variable, traceLink);
    find fileOf(traceLink, "BecomesTrueInside.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
}

@Constraint(key = {variable}, severity = "error", message = "counterexample")
pattern all_Variable_BecomesTrueInside_referrers_TraceLink_modelica_container_is_TraceLi(variable : Variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "BecomesTrueInside");
    TraceLink(traceLink);
    find fileOf(traceLink, "BecomesTrueInside.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(variable, traceLink2);
    find fileOf(traceLink2, "BecomesTrueInside.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "BecomesTrueInside");
    TraceLink(traceLink);
    find fileOf(traceLink, "BecomesTrueInside.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_Variable_BecomesTrueInside_referrers_TraceLink_modelica_container_is_TraceLi_path(variable, modelica);
}

pattern all_Variable_BecomesTrueInside_referrers_TraceLink_modelica_container_is_TraceLi_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "BecomesTrueInside.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

