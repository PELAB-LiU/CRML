@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_ETL_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_3(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "ETL");
    TraceLink(traceLink);
    find fileOf(traceLink, "CountInside.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(customOperator, traceLink2);
    find fileOf(traceLink2, "CountInside.trace");
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "ETL");
    TraceLink(traceLink);
    find fileOf(traceLink, "CountInside.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_CustomOperator_ETL_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_3_path(customOperator, modelica);
}

