pattern CustomOperator_ETL_becomes_true_inside_referrers_TraceLink_kind_is_OPERATOR_TO_B(n : java Integer) {
    n == count find CustomOperator_ETL_becomes_true_inside_referrers_TraceLink_kind_is_OPERATOR_TO_B_matches(_);
