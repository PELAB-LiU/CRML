pattern all_CustomOperator_Extended_referrers_TraceLink_modelica_container_is_TraceLink(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Extended");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseTransitive.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(customOperator, traceLink2);
    find fileOf(traceLink2, "UseTransitive.trace");
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Extended");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseTransitive.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_CustomOperator_Extended_referrers_TraceLink_modelica_container_is_TraceLink_path(customOperator, modelica);
}

