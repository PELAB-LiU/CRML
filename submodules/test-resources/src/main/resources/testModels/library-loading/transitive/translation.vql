// ---- Call sites and structure
// x_or_y calls the function of Logic's 'or'.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_UseTransitive_x_or_y_referrers_TraceLink_modelica_binding_function_targ(n : java Integer) {
    n == count find Variable_UseTransitive_x_or_y_referrers_TraceLink_modelica_binding_function_targ_matches(_);
    check(n != 1);
}

pattern Variable_UseTransitive_x_or_y_referrers_TraceLink_modelica_binding_function_targ_matches(x_or_y : Variable) {
    Variable(x_or_y);
    find containerOf(x_or_y, container);
    NamedEntity.name(container, "UseTransitive");
    Variable.name(x_or_y, "x_or_y");
    CustomOperator(customOperator);
    find containerOf(customOperator, container2);
    Library.name(container2, "Logic");
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'or'");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseTransitive.trace");
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(x_or_y, traceLink2);
    find fileOf(traceLink2, "UseTransitive.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    ComponentDeclaration.binding(modelica2, binding);
    FunctionCall.function(binding, function);
    Reference.target(function, modelica);
    1 == count find Variable_UseTransitive_x_or_y_referrers_TraceLink_modelica_binding_function_targ_path(x_or_y, _);
}

pattern Variable_UseTransitive_x_or_y_referrers_TraceLink_modelica_binding_function_targ_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseTransitive.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    ComponentDeclaration.binding(modelica, binding);
    FunctionCall.function(binding, function);
    Reference.target(function, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_UseTransitive_not_x_referrers_TraceLink_modelica_binding_function_targe(n : java Integer) {
    n == count find Variable_UseTransitive_not_x_referrers_TraceLink_modelica_binding_function_targe_matches(_);
    check(n != 1);
}

pattern Variable_UseTransitive_not_x_referrers_TraceLink_modelica_binding_function_targe_matches(not_x : Variable) {
    Variable(not_x);
    find containerOf(not_x, container);
    NamedEntity.name(container, "UseTransitive");
    Variable.name(not_x, "not_x");
    CustomOperator(customOperator);
    find containerOf(customOperator, container2);
    Library.name(container2, "Extended");
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'negation of'");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseTransitive.trace");
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(not_x, traceLink2);
    find fileOf(traceLink2, "UseTransitive.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    ComponentDeclaration.binding(modelica2, binding);
    FunctionCall.function(binding, function);
    Reference.target(function, modelica);
    1 == count find Variable_UseTransitive_not_x_referrers_TraceLink_modelica_binding_function_targe_path(not_x, _);
}

pattern Variable_UseTransitive_not_x_referrers_TraceLink_modelica_binding_function_targe_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseTransitive.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    ComponentDeclaration.binding(modelica, binding);
    FunctionCall.function(binding, function);
    Reference.target(function, v);
}

// Steps that features of several classes answer.

pattern traceLinkOf(o : EObject, value : EObject) {
    TraceLink.crml(value, o);
} or {
    TraceLink.modelica(value, o);
}

pattern nameOf(o : EObject, value) {
    NamedEntity.name(o, value);
} or {
    LibraryDependency.name(o, value);
} or {
    ClassDefinition.name(o, value);
} or {
    ComponentDeclaration.name(o, value);
} or {
    ModificationElement.name(o, value);
} or {
    ReferencePart.name(o, value);
}

pattern partialOf(o : EObject, value) {
    Domain.partial(o, value);
} or {
    ClassDefinition.partial(o, value);
}
