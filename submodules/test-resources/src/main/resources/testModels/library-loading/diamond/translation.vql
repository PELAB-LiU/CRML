// Left: each element once, of the right kind, directly in UseDiamond's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_CustomOperator_Left_referrers_TraceLink_is_1(n : java Integer) {
    n == count find count_CustomOperator_Left_referrers_TraceLink_is_1_matches(_);
    check(n != 1);
}

pattern count_CustomOperator_Left_referrers_TraceLink_is_1_matches(traceLink) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Left");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseDiamond.trace");
    TraceLink.kind(traceLink, TraceLinkKind::OPERATOR_TO_FUNCTION);
}

@Constraint(key = {customOperator}, severity = "error", message = "counterexample")
pattern all_CustomOperator_Left_referrers_TraceLink_kind_is_OPERATOR_TO_FUNCTION(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Left");
    find traceLinkOf(customOperator, traceLink);
    find fileOf(traceLink, "UseDiamond.trace");
    TraceLink.kind(traceLink, kind);
    kind != TraceLinkKind::OPERATOR_TO_FUNCTION;
} or {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Left");
    neg find all_CustomOperator_Left_referrers_TraceLink_kind_is_OPERATOR_TO_FUNCTION_path(customOperator, TraceLinkKind::OPERATOR_TO_FUNCTION);
}

pattern all_CustomOperator_Left_referrers_TraceLink_kind_is_OPERATOR_TO_FUNCTION_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseDiamond.trace");
    TraceLink.kind(traceLink, v);
}

