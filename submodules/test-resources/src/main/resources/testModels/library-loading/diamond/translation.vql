pattern all_CustomOperator_Left_referrers_TraceLink_modelica_container_is_TraceLink_MODE(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Left");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseDiamond.trace");
