pattern CustomOperator_Right_xor_referrers_TraceLink_modelica_statements_value_arguments_matches(customOperator : CustomOperator) {
    CustomOperator(customOperator);
    find containerOf(customOperator, container);
    Library.name(container, "Right");
    CustomOperator.header(customOperator, header);
    Keyword(header);
    Keyword.keyword(header, "'xor'");
    CustomOperator(customOperator2);
    find containerOf(customOperator2, container2);
    Library.name(container2, "Logic");
    CustomOperator.header(customOperator2, header2);
    Keyword(header2);
    Keyword.keyword(header2, "'or'");
    find traceLinkOf(customOperator2, traceLink);
    find fileOf(traceLink, "UseDiamond.trace");
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(customOperator, traceLink2);
    find fileOf(traceLink2, "UseDiamond.trace");
    TraceLink.modelica(traceLink2, modelica2);
    ClassDefinition.statements(modelica2, statements);
    Statement.value(statements, value);
    FunctionCall.arguments(value, arguments);
    ParenthesizedExpression(arguments);
    ParenthesizedExpression.inner(arguments, inner);
    FunctionCall.function(inner, function);
    Reference.target(function, modelica);
    1 == count find CustomOperator_Right_xor_referrers_TraceLink_modelica_statements_value_arguments_path(customOperator, _);
}

pattern CustomOperator_Right_xor_referrers_TraceLink_modelica_statements_value_arguments_path(o : CustomOperator, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseDiamond.trace");
    TraceLink.modelica(traceLink, modelica);
    ClassDefinition.statements(modelica, statements);
    Statement.value(statements, value);
    FunctionCall.arguments(value, arguments);
    ParenthesizedExpression(arguments);
    ParenthesizedExpression.inner(arguments, inner);
    FunctionCall.function(inner, function);
    Reference.target(function, v);
}

// Steps that features of several classes answer.

pattern traceLinkOf(o : EObject, value : EObject) {
    TraceLink.crml(value, o);
} or {
    TraceLink.modelica(value, o);
}

pattern nameOf(o : EObject, value) {
    NamedEntity.name(o, value);
} or {
    LibraryDependency.name(o, value);
} or {
    ClassDefinition.name(o, value);
} or {
    ComponentDeclaration.name(o, value);
} or {
    ModificationElement.name(o, value);
} or {
    ReferencePart.name(o, value);
}

pattern partialOf(o : EObject, value) {
    Domain.partial(o, value);
} or {
    ClassDefinition.partial(o, value);
}
