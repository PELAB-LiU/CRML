pattern Variable_UseClass_pump1_referrers_TraceLink_modelica_name_is_pump1(n : java Integer) {
    n == count find Variable_UseClass_pump1_referrers_TraceLink_modelica_name_is_pump1_matches(_);
    check(n != 1);
