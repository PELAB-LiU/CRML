pattern Variable_UseClass_pump1_referrers_TraceLink_modelica_name_is_pump1_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    find nameOf(modelica, v);
}

// Equipment: each element once, of the right kind, directly in UseClass's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Class_Equipment_referrers_TraceLink_is_1(n : java Integer) {
    n == count find count_Class_Equipment_referrers_TraceLink_is_1_matches(_);
    check(n != 1);
}

pattern count_Class_Equipment_referrers_TraceLink_is_1_matches(traceLink) {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "Equipment");
    find traceLinkOf(class, traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::CLASS_TO_MODEL);
}

@Constraint(key = {class}, severity = "error", message = "counterexample")
pattern all_Class_Equipment_referrers_TraceLink_kind_is_CLASS_TO_MODEL(class : Class) {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "Equipment");
    find traceLinkOf(class, traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, kind);
    kind != TraceLinkKind::CLASS_TO_MODEL;
} or {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "Equipment");
    neg find all_Class_Equipment_referrers_TraceLink_kind_is_CLASS_TO_MODEL_path(class, TraceLinkKind::CLASS_TO_MODEL);
}

pattern all_Class_Equipment_referrers_TraceLink_kind_is_CLASS_TO_MODEL_path(o : Class, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, v);
}

@Constraint(key = {class}, severity = "error", message = "counterexample")
pattern all_Class_Equipment_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_TO(class : Class) {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "Equipment");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(class, traceLink2);
    find fileOf(traceLink2, "UseClass.trace");
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "Equipment");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_Class_Equipment_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_TO_path(class, modelica);
}

pattern all_Class_Equipment_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_TO_path(o : Class, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

