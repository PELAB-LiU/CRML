// ---- Call sites and structure
// pump1 is a Pump, and the constructor binding id = "P1" is kept.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_UseClass_pump1_referrers_TraceLink_modelica_declaredType_target_is_Clas(n : java Integer) {
    n == count find Variable_UseClass_pump1_referrers_TraceLink_modelica_declaredType_target_is_Clas_matches(_);
    check(n != 1);
}

pattern Variable_UseClass_pump1_referrers_TraceLink_modelica_declaredType_target_is_Clas_matches(pump1 : Variable) {
    Variable(pump1);
    find containerOf(pump1, container);
    NamedEntity.name(container, "UseClass");
    Variable.name(pump1, "pump1");
    Class(pump);
    find containerOf(pump, container2);
    Library.name(container2, "Equipment");
    Class.name(pump, "Pump");
    find traceLinkOf(pump, traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::CLASS_TO_MODEL);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(pump1, traceLink2);
    find fileOf(traceLink2, "UseClass.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    ComponentDeclaration.declaredType(modelica2, declaredType);
    Reference.target(declaredType, modelica);
    1 == count find Variable_UseClass_pump1_referrers_TraceLink_modelica_declaredType_target_is_Clas_path(pump1, _);
}

pattern Variable_UseClass_pump1_referrers_TraceLink_modelica_declaredType_target_is_Clas_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    ComponentDeclaration.declaredType(modelica, declaredType);
    Reference.target(declaredType, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_ModificationElement_id_is_1(n : java Integer) {
    n == count find count_ModificationElement_id_is_1_matches(_);
    check(n != 1);
}

pattern count_ModificationElement_id_is_1_matches(id) {
    ModificationElement(id);
    find fileOf(id, "UseClass.mo");
    ModificationElement.name(id, "id");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern ModificationElement_id_value_value_is_P1(n : java Integer) {
    n == count find ModificationElement_id_value_value_is_P1_matches(_);
    check(n != 1);
}

pattern ModificationElement_id_value_value_is_P1_matches(id : ModificationElement) {
    ModificationElement(id);
    find fileOf(id, "UseClass.mo");
    ModificationElement.name(id, "id");
    ModificationElement.value(id, value);
    StringLiteral.value(value, "P1");
}

// Steps that features of several classes answer.

pattern traceLinkOf(o : EObject, value : EObject) {
    TraceLink.crml(value, o);
} or {
    TraceLink.modelica(value, o);
}

pattern nameOf(o : EObject, value) {
    NamedEntity.name(o, value);
} or {
    LibraryDependency.name(o, value);
} or {
    ClassDefinition.name(o, value);
} or {
    ComponentDeclaration.name(o, value);
} or {
    ModificationElement.name(o, value);
} or {
    ReferencePart.name(o, value);
}

pattern partialOf(o : EObject, value) {
    Domain.partial(o, value);
} or {
    ClassDefinition.partial(o, value);
}
