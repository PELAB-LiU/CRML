package expectations;

import "http://www.eclipse.org/emf/2002/Ecore";
import "org.openmodelica.crml.model.metamodel" as model;
import "org.openmodelica.crml.modelica.metamodel" as modelica;
import "org.openmodelica.crml.modelica.trace.metamodel" as trace;

// A library class as a variable type.
// <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
// (see LibraryLoading in :compiler and "Checking a translation" in
// EXPECTATIONS.md). Every expected value follows from the CRML sources.

// What is quantified over, so that no 'all' below passes vacuously.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Variable_UseClass_is_1(n : java Integer) {
    n == count find count_Variable_UseClass_is_1_matches(_);
    check(n != 1);
}

pattern count_Variable_UseClass_is_1_matches(variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseClass");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Class_Equipment_is_1(n : java Integer) {
    n == count find count_Class_Equipment_is_1_matches(_);
    check(n != 1);
}

pattern count_Class_Equipment_is_1_matches(class) {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "Equipment");
}

// ---- UseClass

// Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Model_UseClass_referrers_TraceLink_modelica_file_is_UseClass_mo(n : java Integer) {
    n == count find Model_UseClass_referrers_TraceLink_modelica_file_is_UseClass_mo_matches(_);
    check(n != 1);
}

pattern Model_UseClass_referrers_TraceLink_modelica_file_is_UseClass_mo_matches(useClass : Model) {
    Model.name(useClass, "UseClass");
    find traceLinkOf(useClass, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, "UseClass.mo");
    1 == count find Model_UseClass_referrers_TraceLink_modelica_file_is_UseClass_mo_path(useClass, _);
}

pattern Model_UseClass_referrers_TraceLink_modelica_file_is_UseClass_mo_path(o : Model, v) {
    find traceLinkOf(o, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_UseClass(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_name_is_UseClass_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_UseClass_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find nameOf(modelica, "UseClass");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_false(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_partial_is_false_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_false_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find partialOf(modelica, false);
}

// Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
@Constraint(key = {traceLink}, severity = "error", message = "must not exist")
pattern count_TraceLink_UNSUPPORTED_is_0(traceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
}

@Constraint(key = {placeholder}, severity = "error", message = "must not exist")
pattern count_Placeholder_is_0(placeholder) {
    Placeholder(placeholder);
    find fileOf(placeholder, "UseClass.mo");
}

@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_UNRESOLVED_not_empty_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "UseClass.mo");
    Reference.reason(reference, RawReason::UNRESOLVED);
    Reference.rawText(reference, rawText);
    rawText != "";
}

@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_not_UseClass_mo_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "UseClass.mo");
    Reference.target(reference, target);
    find fileOf(target, file);
    file != "UseClass.mo";
}

// Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected 2")
pattern count_ClassDefinition_is_2(n : java Integer) {
    n == count find count_ClassDefinition_is_2_matches(_);
    check(n != 2);
}

pattern count_ClassDefinition_is_2_matches(classDefinition) {
    ClassDefinition(classDefinition);
    find fileOf(classDefinition, "UseClass.mo");
}

// UseClass (own): each element once, of the right kind, directly in UseClass's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Variable_UseClass_referrers_TraceLink_is_1(n : java Integer) {
    n == count find count_Variable_UseClass_referrers_TraceLink_is_1_matches(_);
    check(n != 1);
}

pattern count_Variable_UseClass_referrers_TraceLink_is_1_matches(traceLink) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseClass");
    find traceLinkOf(variable, traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
}

@Constraint(key = {variable}, severity = "error", message = "counterexample")
pattern all_Variable_UseClass_referrers_TraceLink_modelica_container_is_TraceLink_MODEL(variable : Variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseClass");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(variable, traceLink2);
    find fileOf(traceLink2, "UseClass.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "UseClass");
    TraceLink(traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_Variable_UseClass_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_path(variable, modelica);
}

pattern all_Variable_UseClass_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_path(o : Variable, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "UseClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::VARIABLE_TO_COMPONENT);
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

