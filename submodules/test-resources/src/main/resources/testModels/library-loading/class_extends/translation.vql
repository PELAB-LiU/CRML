// ---- Call sites and structure
// Pump extends the Machine generated into the same model; pump1 is a Pump.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Class_ExtendClass_Pump_referrers_TraceLink_modelica_extendsClauses_superClass_ta(n : java Integer) {
    n == count find Class_ExtendClass_Pump_referrers_TraceLink_modelica_extendsClauses_superClass_ta_matches(_);
    check(n != 1);
}

pattern Class_ExtendClass_Pump_referrers_TraceLink_modelica_extendsClauses_superClass_ta_matches(pump : Class) {
    Class(pump);
    find containerOf(pump, container);
    Library.name(container, "ExtendClass");
    Class.name(pump, "Pump");
    Class(machine);
    find containerOf(machine, container2);
    Library.name(container2, "Equipment");
    Class.name(machine, "Machine");
    find traceLinkOf(machine, traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::CLASS_TO_MODEL);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(pump, traceLink2);
    find fileOf(traceLink2, "ExtendClass.trace");
    TraceLink.kind(traceLink2, TraceLinkKind::CLASS_TO_MODEL);
    TraceLink.modelica(traceLink2, modelica2);
    ClassDefinition.extendsClauses(modelica2, extendsClauses);
    ExtendsClause.superClass(extendsClauses, superClass);
    Reference.target(superClass, modelica);
    1 == count find Class_ExtendClass_Pump_referrers_TraceLink_modelica_extendsClauses_superClass_ta_path(pump, _);
}

pattern Class_ExtendClass_Pump_referrers_TraceLink_modelica_extendsClauses_superClass_ta_path(o : Class, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::CLASS_TO_MODEL);
    TraceLink.modelica(traceLink, modelica);
    ClassDefinition.extendsClauses(modelica, extendsClauses);
    ExtendsClause.superClass(extendsClauses, superClass);
    Reference.target(superClass, v);
}

