package expectations;

import "http://www.eclipse.org/emf/2002/Ecore";
import "org.openmodelica.crml.model.metamodel" as model;
import "org.openmodelica.crml.modelica.metamodel" as modelica;
import "org.openmodelica.crml.modelica.trace.metamodel" as trace;

// A model class extending a library class.
// <Model>.mo is the Modelica class generated for a model, <Model>.trace its trace
// (see LibraryLoading in :compiler and "Checking a translation" in
// EXPECTATIONS.md). Every expected value follows from the CRML sources.

// What is quantified over, so that no 'all' below passes vacuously.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Class_ExtendClass_is_1(n : java Integer) {
    n == count find count_Class_ExtendClass_is_1_matches(_);
    check(n != 1);
}

pattern count_Class_ExtendClass_is_1_matches(class) {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "ExtendClass");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Variable_ExtendClass_is_1(n : java Integer) {
    n == count find count_Variable_ExtendClass_is_1_matches(_);
    check(n != 1);
}

pattern count_Variable_ExtendClass_is_1_matches(variable) {
    Variable(variable);
    find containerOf(variable, container);
    NamedEntity.name(container, "ExtendClass");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Class_Equipment_is_1(n : java Integer) {
    n == count find count_Class_Equipment_is_1_matches(_);
    check(n != 1);
}

pattern count_Class_Equipment_is_1_matches(class) {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "Equipment");
}

// ---- ExtendClass

// Its class, and whether it is partial (it is when a variable it has, own or inherited, is unbound).
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Model_ExtendClass_referrers_TraceLink_modelica_file_is_ExtendClass_mo(n : java Integer) {
    n == count find Model_ExtendClass_referrers_TraceLink_modelica_file_is_ExtendClass_mo_matches(_);
    check(n != 1);
}

pattern Model_ExtendClass_referrers_TraceLink_modelica_file_is_ExtendClass_mo_matches(extendClass : Model) {
    Model.name(extendClass, "ExtendClass");
    find traceLinkOf(extendClass, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, "ExtendClass.mo");
    1 == count find Model_ExtendClass_referrers_TraceLink_modelica_file_is_ExtendClass_mo_path(extendClass, _);
}

pattern Model_ExtendClass_referrers_TraceLink_modelica_file_is_ExtendClass_mo_path(o : Model, v) {
    find traceLinkOf(o, traceLink);
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find fileOf(modelica, v);
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_ExtendClass(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_name_is_ExtendClass_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_name_is_ExtendClass_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find nameOf(modelica, "ExtendClass");
}

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_true(n : java Integer) {
    n == count find TraceLink_MODEL_TO_CLASS_modelica_partial_is_true_matches(_);
    check(n != 1);
}

pattern TraceLink_MODEL_TO_CLASS_modelica_partial_is_true_matches(traceLink : TraceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find partialOf(modelica, true);
}

// Nothing dropped, at any depth; no unresolved name, no reference into another model's class.
@Constraint(key = {traceLink}, severity = "error", message = "must not exist")
pattern count_TraceLink_UNSUPPORTED_is_0(traceLink) {
    TraceLink(traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::UNSUPPORTED);
}

@Constraint(key = {placeholder}, severity = "error", message = "must not exist")
pattern count_Placeholder_is_0(placeholder) {
    Placeholder(placeholder);
    find fileOf(placeholder, "ExtendClass.mo");
}

@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_UNRESOLVED_not_empty_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "ExtendClass.mo");
    Reference.reason(reference, RawReason::UNRESOLVED);
    Reference.rawText(reference, rawText);
    rawText != "";
}

@Constraint(key = {reference}, severity = "error", message = "must not exist")
pattern count_Reference_not_ExtendClass_mo_is_0(reference) {
    Reference(reference);
    find fileOf(reference, "ExtendClass.mo");
    Reference.target(reference, target);
    find fileOf(target, file);
    file != "ExtendClass.mo";
}

// Exactly one generated class per model, operator and class it reaches: nothing twice, nothing extra.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected 3")
pattern count_ClassDefinition_is_3(n : java Integer) {
    n == count find count_ClassDefinition_is_3_matches(_);
    check(n != 3);
}

pattern count_ClassDefinition_is_3_matches(classDefinition) {
    ClassDefinition(classDefinition);
    find fileOf(classDefinition, "ExtendClass.mo");
}

// ExtendClass (own): each element once, of the right kind, directly in ExtendClass's class.
@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern count_Class_ExtendClass_referrers_TraceLink_is_1(n : java Integer) {
    n == count find count_Class_ExtendClass_referrers_TraceLink_is_1_matches(_);
    check(n != 1);
}

pattern count_Class_ExtendClass_referrers_TraceLink_is_1_matches(traceLink) {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "ExtendClass");
    find traceLinkOf(class, traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::CLASS_TO_MODEL);
}

@Constraint(key = {class}, severity = "error", message = "counterexample")
pattern all_Class_ExtendClass_referrers_TraceLink_kind_is_CLASS_TO_MODEL(class : Class) {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "ExtendClass");
    find traceLinkOf(class, traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, kind);
    kind != TraceLinkKind::CLASS_TO_MODEL;
} or {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "ExtendClass");
    neg find all_Class_ExtendClass_referrers_TraceLink_kind_is_CLASS_TO_MODEL_path(class, TraceLinkKind::CLASS_TO_MODEL);
}

pattern all_Class_ExtendClass_referrers_TraceLink_kind_is_CLASS_TO_MODEL_path(o : Class, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, v);
}

@Constraint(key = {class}, severity = "error", message = "counterexample")
pattern all_Class_ExtendClass_referrers_TraceLink_modelica_container_is_TraceLink_MODEL(class : Class) {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "ExtendClass");
    TraceLink(traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    find traceLinkOf(class, traceLink2);
    find fileOf(traceLink2, "ExtendClass.trace");
    TraceLink.modelica(traceLink2, modelica2);
    find containerOf(modelica2, container2);
    container2 != modelica;
} or {
    Class(class);
    find containerOf(class, container);
    Library.name(container, "ExtendClass");
    TraceLink(traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.kind(traceLink, TraceLinkKind::MODEL_TO_CLASS);
    TraceLink.modelica(traceLink, modelica);
    neg find all_Class_ExtendClass_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_path(class, modelica);
}

pattern all_Class_ExtendClass_referrers_TraceLink_modelica_container_is_TraceLink_MODEL_path(o : Class, v) {
    find traceLinkOf(o, traceLink);
    find fileOf(traceLink, "ExtendClass.trace");
    TraceLink.modelica(traceLink, modelica);
    find containerOf(modelica, v);
}

