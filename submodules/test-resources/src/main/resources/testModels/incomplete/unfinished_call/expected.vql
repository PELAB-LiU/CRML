package expectations;

import "http://www.eclipse.org/emf/2002/Ecore";
import "org.openmodelica.crml.model.metamodel" as metamodel;

@Constraint(key = {n}, severity = "error", message = "found $n$, expected exactly 1")
pattern Variable_y_definition_isA_Sequence(n : java Integer) {
    n == count find Variable_y_definition_isA_Sequence_matches(_);
    check(n != 1);
}

pattern Variable_y_definition_isA_Sequence_matches(y : Variable) {
    Variable.name(y, "y");
    Variable.definition(y, definition);
    Sequence(definition);
}
