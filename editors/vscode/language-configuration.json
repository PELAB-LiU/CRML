{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  // Square brackets are left out: period intervals such as ]a, b[ pair them
  // in every direction, which bracket matching would flag as unbalanced.
  "brackets": [
    ["{", "}"],
    ["(", ")"]
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ]
}
